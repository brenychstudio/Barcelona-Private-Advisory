---
import "../styles/global.css";
import Header from "../components/ui/Header.astro";
import RightSideNav from "../components/ui/RightSideNav.astro";
import WhatsAppFab from "../components/ui/WhatsAppFab.astro";
import Footer from "../components/ui/Footer.astro";
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, OG_IMAGE, INDEXABLE } from "../config/site";
import { ClientRouter, fade } from "astro:transitions";

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_NAME, description = SITE_DESCRIPTION } = Astro.props;

const path = Astro.url.pathname;
const isEs = path.startsWith("/es");
const lang = isEs ? "es" : "en";
const routePath = (isEs ? path.replace(/^\/es(?=\/|$)/, "") || "/" : path).replace(/\/$/, "") || "/";
const legalRoutes = new Set(["/legal", "/privacy", "/cookies", "/terms", "/accessibility", "/demo-notice"]);
const bcnRoute =
  routePath === "/"
    ? "home"
    : routePath.startsWith("/search")
      ? "search"
      : routePath.startsWith("/about")
        ? "about"
        : routePath.startsWith("/contact")
          ? "contact"
          : routePath.startsWith("/p/")
            ? "property"
            : legalRoutes.has(routePath)
              ? "legal"
              : "default";

const canonical = new URL(path, SITE_URL).toString();
const ogImageAbs = new URL(OG_IMAGE, SITE_URL).toString();

const robots = INDEXABLE ? "index,follow" : "noindex,nofollow";

const base = isEs ? (path.replace(/^\/es/, "") || "/") : path;
const enPath = base;
const esPath = base === "/" ? "/es" : `/es${base}`;
const altEn = new URL(enPath, SITE_URL).toString();
const altEs = new URL(esPath, SITE_URL).toString();

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}#org`,
      name: SITE_NAME,
      url: SITE_URL,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}#website`,
      url: SITE_URL,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      publisher: { "@id": `${SITE_URL}#org` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json">{JSON.stringify(schemaOrg)}</script>

    <ClientRouter />
  </head>

  <body class="overflow-x-hidden" data-bcn-route={bcnRoute}>
    <div class="bcn-atmospheric-field" aria-hidden="true"></div>
    <Header />
    <RightSideNav />

    <main
      transition:animate={fade({ duration: "0.35s" })}
      class="bcn-page-shell mx-auto w-full max-w-[1760px] overflow-x-clip px-4 pb-24 pt-8 sm:px-6 sm:pt-10 2xl:px-10"
    >
      <slot />
      <Footer />
    </main>

    <WhatsAppFab />
  </body>
</html>
