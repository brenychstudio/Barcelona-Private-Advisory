---
import "../styles/global.css";
import Header from "../components/ui/Header.astro";
import RightSideNav from "../components/ui/RightSideNav.astro";
import WhatsAppFab from "../components/ui/WhatsAppFab.astro";
import Footer from "../components/ui/Footer.astro";
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, OG_IMAGE, INDEXABLE } from "../config/site";
import type { SeoMetadata } from "../lib/seo";
import { ClientRouter, fade } from "astro:transitions";

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMetadata;
};

const { title, description, seo } = Astro.props;

const path = Astro.url.pathname;
const isEs = path.startsWith("/es");
const inferredLang = isEs ? "es" : "en";
const routePath = (isEs ? path.replace(/^\/es(?=\/|$)/, "") || "/" : path).replace(/\/$/, "") || "/";
const legalRoutes = new Set(["/legal", "/privacy", "/cookies", "/terms", "/accessibility", "/demo-notice"]);
const bcnRoute =
  routePath === "/"
    ? "home"
    : routePath.startsWith("/search")
      ? "search"
      : routePath.startsWith("/about")
        ? "about"
        : routePath.startsWith("/contact")
          ? "contact"
          : routePath.startsWith("/p/")
            ? "property"
            : legalRoutes.has(routePath)
              ? "legal"
              : "default";

const base = isEs ? (path.replace(/^\/es/, "") || "/") : path;
const fallbackEnPath = base;
const fallbackEsPath = base === "/" ? "/es/" : `/es${base}`;

const metadata: SeoMetadata = seo ?? {
  title: title ?? SITE_NAME,
  description: description ?? SITE_DESCRIPTION,
  canonicalPath: path,
  lang: inferredLang,
  alternatePath: inferredLang === "en" ? fallbackEsPath : fallbackEnPath,
  ogTitle: title ?? SITE_NAME,
  ogDescription: description ?? SITE_DESCRIPTION,
  ogImage: OG_IMAGE,
  ogType: "website",
  robots: "index,follow",
};

const lang = metadata.lang;
const canonical = new URL(metadata.canonicalPath, SITE_URL).toString();
const ogImageAbs = new URL(metadata.ogImage, SITE_URL).toString();

const robots = INDEXABLE ? metadata.robots : "noindex,nofollow";

const enPath = lang === "en" ? metadata.canonicalPath : metadata.alternatePath;
const esPath = lang === "es" ? metadata.canonicalPath : metadata.alternatePath;
const altEn = new URL(enPath, SITE_URL).toString();
const altEs = new URL(esPath, SITE_URL).toString();

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}#website`,
      url: SITE_URL,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={robots} />

    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />

    <meta property="og:type" content={metadata.ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={metadata.ogTitle} />
    <meta property="og:description" content={metadata.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Barcelona Private Advisory social preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.ogTitle} />
    <meta name="twitter:description" content={metadata.ogDescription} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json">{JSON.stringify(schemaOrg)}</script>
    <script is:inline>
      (() => {
        if (window.__bcnRevealReady) return;
        window.__bcnRevealReady = true;

        const initReveal = () => {
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const revealNodes = Array.from(document.querySelectorAll("[data-bcn-reveal]:not(.is-visible)"));

          if (reduceMotion || !("IntersectionObserver" in window)) {
            revealNodes.forEach((node) => node.classList.add("is-visible"));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              });
            },
            {
              rootMargin: "0px 0px -12% 0px",
              threshold: 0.12,
            },
          );

          revealNodes.forEach((node) => observer.observe(node));
        };

        const scheduleReveal = () => {
          initReveal();
          window.requestAnimationFrame(initReveal);
          window.setTimeout(initReveal, 240);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", scheduleReveal, { once: true });
        } else {
          scheduleReveal();
        }

        document.addEventListener("astro:page-load", scheduleReveal);
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="overflow-x-hidden" data-bcn-route={bcnRoute}>
    <div class="bcn-atmospheric-field" aria-hidden="true"></div>
    <Header />
    <RightSideNav />

    <main
      transition:animate={fade({ duration: "0.35s" })}
      class="bcn-page-shell mx-auto w-full max-w-[1760px] overflow-x-clip px-4 pb-24 pt-8 sm:px-6 sm:pt-10 2xl:px-10"
    >
      <slot />
      <Footer />
    </main>

    <WhatsAppFab />
  </body>
</html>
