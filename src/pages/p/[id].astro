---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PropertyShowcase from "../../components/islands/PropertyShowcase";
import { listings } from "../../data/listings";
import { getPropertySeo } from "../../lib/seo";

export function getStaticPaths() {
  return listings.map((x) => ({
    params: { id: x.id },
    props: { listing: x },
  }));
}

const { listing } = Astro.props;
const seo = getPropertySeo(listing, "en");
---

<BaseLayout seo={seo}>
  <PropertyShowcase client:load listing={listing} />
</BaseLayout>
