---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { bcnMedia } from "../../data/bcnMedia";
import { bcnLensMedia } from "../../data/bcnLensMedia";

const briefRows = [
  ["Buyer intent", "Family calm, sea light, investment logic, privacy or another clear buyer priority."],
  ["Preferred districts", "The district lens that should frame daily life, access, light and long-term value."],
  ["Budget / timing", "Commercial range, decision timing and how urgent the viewing path should be."],
  ["Selected properties", "Shortlisted homes or one specific property that should anchor the request."],
  ["Trade-offs / constraints", "Noise, renovation tolerance, school routes, liquidity, fees or privacy concerns."],
  ["Viewing priority", "Which options should be inspected first and what would make the viewing worthwhile."],
];

const methodSteps = [
  ["01", "Prepare brief", "Open the Request Viewing Path panel and add timing, budget, constraints and questions."],
  ["02", "Review shortlist fit", "Use saved properties, district context and advisory signals to keep the request focused."],
  ["03", "Share with advisor", "Copy the brief when ready. Nothing is sent automatically in this portfolio build."],
];
---

<BaseLayout
  title="Advisory Handoff - Barcelona Private Advisory"
  description="Prepare a private viewing path request from buyer intent, district fit, shortlist context and timing."
>
  <section class="bcn-section grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
    <div class="space-y-5">
      <div class="bcn-signal-kicker text-[12px] uppercase tracking-[0.2em] text-black/42">Advisory handoff</div>
      <h1 class="bcn-advisory-line max-w-[780px] text-[42px] leading-[0.98] tracking-tight text-black/90 sm:text-[64px]">
        Prepare a private viewing path.
      </h1>
      <p class="max-w-[700px] text-[14px] leading-[1.85] text-black/58">
        Build a buyer brief from intent, district fit, shortlist context and timing, then copy it when you are ready
        to hand it off. This page supports the same request flow used across the Lens, property detail and dossier.
      </p>
    </div>

    <figure class="overflow-hidden border border-black/10 bg-[rgb(var(--paper))]">
      <img
        src={bcnLensMedia.materials.handoff.src}
        alt={bcnLensMedia.materials.handoff.alt}
        width={bcnLensMedia.materials.handoff.width}
        height={bcnLensMedia.materials.handoff.height}
        class="aspect-[16/10] w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </figure>
  </section>

  <section class="bcn-section--threshold mt-28 grid gap-10 border-y border-black/10 py-14 lg:grid-cols-[0.7fr_1.3fr]">
    <div>
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Brief content</div>
      <h2 class="mt-4 max-w-[520px] text-[32px] leading-[1.02] tracking-tight">
        What a useful request should include.
      </h2>
    </div>

    <div class="grid gap-0 border-t border-black/10">
      {briefRows.map(([label, text]) => (
        <div class="grid gap-3 border-b border-black/10 py-4 last:border-b-0 sm:grid-cols-[190px_1fr]">
          <div class="text-[12px] tracking-[0.16em] text-black/42">{label}</div>
          <p class="text-[13px] leading-[1.7] text-black/62">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bcn-editorial-surface mt-28 overflow-hidden border border-black/10 bg-[rgb(var(--paper))]">
    <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
      <figure class="min-h-[320px]">
        <img
          src={bcnMedia.dossier.acquisitionMemoDetail.src}
          alt={bcnMedia.dossier.acquisitionMemoDetail.alt}
          width={bcnMedia.dossier.acquisitionMemoDetail.width}
          height={bcnMedia.dossier.acquisitionMemoDetail.height}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="p-6 sm:p-8 lg:p-10">
        <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Request brief surface</div>
        <h2 class="mt-4 max-w-[560px] text-[34px] leading-[1.02] tracking-tight">
          Use the Request Viewing Path panel for the richest context.
        </h2>
        <p class="mt-5 max-w-[620px] text-[13px] leading-[1.85] text-black/58">
          The panel prepares a local, copy-ready advisory request. It can include property context, dossier count,
          district lens, next action, buyer notes and preferred timing.
        </p>
        <div class="mt-6 border-t border-black/10 pt-5 text-[12px] leading-[1.75] text-black/54">
          No message is sent automatically. No placeholder contact data is used. A production deployment can connect this handoff
          to a real CRM, email workflow, calendar or WhatsApp contact.
        </div>

        <div class="mt-7 flex flex-wrap gap-2">
          <button
            type="button"
            data-open-inquiry
            data-inquiry-source="contact"
            data-inquiry-next-action="Prepare viewing path"
            class="rounded-full border border-black/20 bg-white px-4 py-2 text-[12px] hover:border-black/35 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
          >
            Open Request Viewing Path
          </button>
          <a
            href="/search"
            class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
          >
            Open Private Search
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-24 space-y-8">
    <div class="max-w-[680px] space-y-3">
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Handoff method</div>
      <h2 class="text-[32px] leading-[1.03] tracking-tight">From search context to advisor-ready brief.</h2>
    </div>

    <div class="grid gap-0 border-y border-black/10 md:grid-cols-3">
      {methodSteps.map(([n, title, text]) => (
        <div class="border-b border-black/10 py-6 md:border-b-0 md:border-r md:px-6 md:last:border-r-0">
          <div class="text-[11px] tracking-[0.18em] text-black/36">{n}</div>
          <div class="mt-4 text-[18px] tracking-tight text-black/84">{title}</div>
          <p class="mt-3 max-w-[300px] text-[12px] leading-[1.75] text-black/56">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-20 border-t border-black/10 pt-8">
    <div class="max-w-[820px] text-[13px] leading-[1.85] text-black/56">
      Local privacy note: this portfolio build prepares copy locally in the browser. It does not submit forms,
      store contact details, send messages or use placeholder advisory contact targets.
    </div>
  </section>
</BaseLayout>
