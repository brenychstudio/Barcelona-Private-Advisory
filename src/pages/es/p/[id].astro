---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PropertyShowcase from "../../../components/islands/PropertyShowcase";
import { listings } from "../../../data/listings";
import { getPropertySeo } from "../../../lib/seo";

export function getStaticPaths() {
  return listings.map((l) => ({
    params: { id: l.id },
    props: { listing: l },
  }));
}

const { listing } = Astro.props;
const seo = getPropertySeo(listing, "es");
---

<BaseLayout seo={seo}>
  <PropertyShowcase client:load listing={listing} lang="es" />
</BaseLayout>
