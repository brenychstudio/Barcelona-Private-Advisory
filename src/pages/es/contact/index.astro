---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { bcnMedia } from "../../../data/bcnMedia";
import { bcnLensMedia } from "../../../data/bcnLensMedia";
import { getRouteSeo } from "../../../lib/seo";

const seo = getRouteSeo("contact", "es");

const briefRows = [
  ["01", "Intención del comprador", "Nombra la prioridad antes de que el inventario domine."],
  ["02", "Distritos preferidos", "Mantiene la solicitud anclada en vida diaria y lógica de valor."],
  ["03", "Presupuesto / timing", "Enmarca el rango comercial y la urgencia de la ruta de visita."],
  ["04", "Propiedades seleccionadas", "Lleva selección o contexto de propiedad al handoff."],
  ["05", "Compensaciones / límites", "Expone tolerancia a riesgo, cuotas, reforma o privacidad."],
  ["06", "Prioridad de visita", "Aclara qué opciones conviene inspeccionar primero."],
];

const requestRows = [
  ["Fuente", "Búsqueda / Propiedad / Dossier"],
  ["Contexto", "Lente de distrito + propiedades seleccionadas"],
  ["Resultado", "Solicitud de ruta de visita lista para copiar."],
];

const methodSteps = [
  ["01", "Preparar brief", "Añade timing, presupuesto y límites."],
  ["02", "Revisar ajuste", "Usa selección y contexto de distrito."],
  ["03", "Compartir brief", "Copia cuando esté listo. Nada se envía automáticamente."],
];
---

<BaseLayout seo={seo}>
  <section class="bcn-contact-hero bcn-section grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end" data-bcn-reveal="section">
    <div class="space-y-5">
      <div class="bcn-signal-kicker text-[12px] uppercase tracking-[0.2em] text-black/42">Handoff asesor</div>
      <h1 class="bcn-advisory-line max-w-[780px] text-[42px] leading-[0.98] tracking-tight text-black/90 sm:text-[64px]">
        Prepara una ruta de visita privada.
      </h1>
      <p class="max-w-[700px] text-[14px] leading-[1.85] text-black/58">
        Construye un brief desde intención, ajuste de distrito, selección y timing, y cópialo cuando esté listo.
      </p>
      <div class="bcn-contact-hero-actions">
        <button
          type="button"
          data-open-inquiry
          data-inquiry-source="contact"
          data-inquiry-next-action="Preparar ruta de visita"
        >
          Abrir solicitud de ruta de visita
        </button>
        <a href="/es/search">Abrir búsqueda privada</a>
      </div>
    </div>

    <figure class="overflow-hidden border border-black/10 bg-[rgb(var(--paper))]" data-bcn-reveal="media" data-bcn-reveal-delay="1">
      <img
        src={bcnLensMedia.materials.handoff.src}
        alt={bcnLensMedia.materials.handoff.alt}
        width={bcnLensMedia.materials.handoff.width}
        height={bcnLensMedia.materials.handoff.height}
        class="aspect-[16/10] w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </figure>
  </section>

  <section class="bcn-contact-anatomy-section bcn-section--threshold mt-28 grid gap-10 border-y border-black/10 py-14 lg:grid-cols-[0.7fr_1.3fr]" data-bcn-reveal="section">
    <div>
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Anatomía de solicitud</div>
      <h2 class="mt-4 max-w-[520px] text-[32px] leading-[1.02] tracking-tight">
        Qué debe incluir una solicitud útil.
      </h2>
    </div>

    <div class="bcn-request-anatomy">
      {briefRows.map(([n, label, text], index) => (
        <article class="bcn-request-anatomy__item" data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <div class="bcn-request-anatomy__number">{n}</div>
          <div>
            <h3>{label}</h3>
            <p>{text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bcn-editorial-surface bcn-contact-handoff mt-28 overflow-hidden border border-black/10 bg-[rgb(var(--paper))]" data-bcn-reveal="section">
    <div class="grid gap-0 lg:grid-cols-[0.88fr_1.12fr]">
      <figure class="min-h-[320px]" data-bcn-reveal="media">
        <img
          src={bcnMedia.dossier.acquisitionMemoDetail.src}
          alt={bcnMedia.dossier.acquisitionMemoDetail.alt}
          width={bcnMedia.dossier.acquisitionMemoDetail.width}
          height={bcnMedia.dossier.acquisitionMemoDetail.height}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="p-6 sm:p-8 lg:p-10">
        <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Superficie de solicitud</div>
        <h2 class="mt-4 max-w-[560px] text-[34px] leading-[1.02] tracking-tight">
          El output final antes del primer mensaje.
        </h2>
        <p class="mt-5 max-w-[620px] text-[13px] leading-[1.85] text-black/58">
          El panel Solicitar ruta de visita convierte búsqueda, propiedad y dossier en un brief local que el comprador puede revisar antes de copiar.
        </p>

        <div class="bcn-request-brief-readout bcn-request-surface mt-7" data-bcn-reveal="card" data-bcn-reveal-delay="1">
          <div class="bcn-request-surface__header">
            <div>
              <div class="bcn-request-surface__eyebrow">Brief privado de solicitud</div>
              <h3>Preparado localmente desde el contexto asesor actual.</h3>
            </div>
            <div class="bcn-request-surface__status">Listo para copiar</div>
          </div>

          <div class="bcn-request-surface__rows">
            {requestRows.map(([label, value]) => (
              <div class="bcn-request-surface__row">
                <div>{label}</div>
                <p>{value}</p>
              </div>
            ))}
          </div>

          <div class="bcn-request-surface__actions">
            <button
              type="button"
              data-open-inquiry
              data-inquiry-source="contact"
              data-inquiry-next-action="Preparar ruta de visita"
              class="rounded-full border border-black/20 bg-white px-4 py-2 text-[12px] hover:border-black/35 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
            >
              Abrir solicitud de ruta de visita
            </button>
            <a
              href="/es/search"
              class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
            >
              Abrir búsqueda privada
            </a>
          </div>
        </div>
        <div class="bcn-contact-request-note mt-6 text-[12px] leading-[1.75] text-black/54">
          Preparado localmente. No se envía ningún mensaje automáticamente. Producción puede conectar CRM, email, calendario o WhatsApp.
        </div>
      </div>
    </div>
  </section>

  <section class="bcn-contact-method mt-24 space-y-8" data-bcn-reveal="section">
    <div class="max-w-[680px] space-y-3">
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Método de handoff</div>
      <h2 class="text-[32px] leading-[1.03] tracking-tight">Del contexto de búsqueda al brief preparado para asesoría.</h2>
    </div>

    <div class="bcn-handoff-method grid gap-0 border-y border-black/10 md:grid-cols-3">
      {methodSteps.map(([n, title, text], index) => (
        <article class="bcn-handoff-method__step border-b border-black/10 py-6 md:border-b-0 md:border-r md:px-6 md:last:border-r-0" data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <div class="text-[11px] tracking-[0.18em] text-black/36">{n}</div>
          <div class="mt-4 text-[18px] tracking-tight text-black/84">{title}</div>
          <p class="mt-3 max-w-[300px] text-[12px] leading-[1.75] text-black/56">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bcn-contact-privacy mt-20 border-t border-black/10 pt-8" data-bcn-reveal="section">
    <div class="max-w-[820px] text-[13px] leading-[1.85] text-black/56">
      Nota de privacidad local: el texto se prepara localmente en el navegador. Este portfolio build no envía formularios, no guarda datos de contacto ni manda mensajes.
    </div>
  </section>
</BaseLayout>
