---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto — Barcelona Private Advisory"
  description="Intake privado para Barcelona Private Advisory — solicitar shortlist, llamada advisory o guía para el siguiente paso."
>
  <section class="space-y-4">
    <div class="text-[12px] tracking-[0.18em] text-black/42">INTAKE PRIVADO</div>

    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div class="space-y-4">
        <h1 class="max-w-[720px] text-[30px] leading-[1.03] tracking-tight sm:text-[38px]">
          Inicia una búsqueda privada,
          <br />
          no una consulta genérica.
        </h1>

        <p class="max-w-[700px] text-[13px] leading-[1.9] text-black/58">
          Este intake está diseñado como un brief de comprador, no como un formulario de contacto amplio.
          Comparte timing, distritos preferidos, rango de presupuesto y restricciones — y conviértelo en un borrador curado por email o WhatsApp.
        </p>
      </div>

      <div class="max-w-[760px] border-l border-black/10 pl-5 text-[12px] leading-[1.85] text-black/48 lg:ml-auto">
        En producción, esta sección se conectaría a Formspree, CRM o un workflow privado de inbox.
        En el demo, está estructurada como intake advisory premium con acciones de copiar / email / WhatsApp.
      </div>
    </div>
  </section>

  <section class="mt-16 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="space-y-10">
      <div class="space-y-0 border-t border-black/10">
        {[
          ["Línea directa", "+34 600 000 000", "Demo placeholder · canal prioritario para consultas con intención alta."],
          ["Email", "advisory@example.com", "Usado para briefs, follow-ups y entrega de shortlist."],
          ["WhatsApp", "Abrir WhatsApp", "La vía más rápida para un primer brief o un seguimiento de shortlist."],
          ["Oficina", "Barcelona — Eixample (demo)", "Lun–Vie · 10:00–18:00 · reuniones con cita previa."],
        ].map(([label, value, note], i) => (
          <div class="grid gap-2 border-b border-black/10 py-4 last:border-b-0 sm:grid-cols-[150px_1fr]">
            <div class="text-[12px] tracking-[0.18em] text-black/42">{label}</div>

            <div class="space-y-2">
              {i === 2 ? (
                <a
                  href="https://wa.me/34600000000"
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex rounded-full border border-black/15 px-3 py-1.5 text-[12px] hover:border-black/25"
                >
                  {value}
                </a>
              ) : i === 1 ? (
                <a
                  href="mailto:advisory@example.com"
                  class="text-[15px] tracking-tight hover:text-black/70"
                >
                  {value}
                </a>
              ) : i === 3 ? (
                <div class="space-y-2">
                  <div class="text-[15px] tracking-tight">{value}</div>
                  <a
                    href="https://maps.google.com/?q=Barcelona+Eixample"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex rounded-full border border-black/10 px-3 py-1.5 text-[12px] text-black/70 hover:border-black/20 hover:text-black"
                  >
                    Abrir en Google Maps
                  </a>
                </div>
              ) : (
                <a
                  href="tel:+34600000000"
                  class="text-[15px] tracking-tight hover:text-black/70"
                >
                  {value}
                </a>
              )}

              <div class="max-w-[460px] text-[12px] leading-[1.8] text-black/56">{note}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-0 border-t border-black/10">
        {[
          ["Ventana de respuesta", "Dentro de un día laborable para briefs cualificados."],
          ["Ideal para", "Compra, relocation, inversión, shortlist, llamada advisory."],
          ["Salida", "Borrador de email, borrador de WhatsApp o brief listo para shortlist."],
        ].map(([label, value]) => (
          <div class="grid gap-2 border-b border-black/10 py-4 last:border-b-0 sm:grid-cols-[150px_1fr]">
            <div class="text-[12px] tracking-[0.18em] text-black/42">{label}</div>
            <div class="text-[12px] leading-[1.8] text-black/56">{value}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-[30px] border border-black/10 bg-white p-5 sm:p-6">
      <div class="space-y-2">
        <div class="text-[12px] tracking-[0.18em] text-black/42">REQUEST BRIEF</div>
        <div class="max-w-[520px] text-[24px] leading-[1.08] tracking-tight">
          Construye una solicitud más clara antes de enviarla.
        </div>
      </div>

      <form id="private-intake-form" class="mt-6 space-y-4">
        <div class="grid gap-3 sm:grid-cols-2">
          <select
            name="requestType"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70"
          >
            <option value="Compra">Compra</option>
            <option value="Inversión">Inversión</option>
            <option value="Relocation">Relocation</option>
            <option value="Llamada advisory">Llamada advisory</option>
            <option value="Venta">Venta</option>
          </select>

          <input
            name="name"
            type="text"
            placeholder="Nombre"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70 placeholder:text-black/32"
          />
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <input
            name="email"
            type="email"
            placeholder="Email"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70 placeholder:text-black/32"
          />
          <input
            name="districts"
            type="text"
            placeholder="Distritos preferidos (ej. Eixample, Gràcia)"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70 placeholder:text-black/32"
          />
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          <select
            name="budget"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70"
          >
            <option value="Presupuesto abierto">Presupuesto abierto</option>
            <option value="Hasta €500k">Hasta €500k</option>
            <option value="€500k–€900k">€500k–€900k</option>
            <option value="€900k–€1.5M">€900k–€1.5M</option>
            <option value="€1.5M+">€1.5M+</option>
          </select>

          <select
            name="timing"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70"
          >
            <option value="Timing flexible">Timing flexible</option>
            <option value="Dentro de 30 días">Dentro de 30 días</option>
            <option value="1–3 meses">1–3 meses</option>
            <option value="3–6 meses">3–6 meses</option>
            <option value="Exploratorio">Exploratorio</option>
          </select>

          <select
            name="propertyType"
            class="h-11 rounded-full border border-black/10 bg-white px-4 text-[12px] text-black/70"
          >
            <option value="Cualquier tipo de propiedad">Cualquier tipo de propiedad</option>
            <option value="Apartamento">Apartamento</option>
            <option value="Ático">Ático</option>
            <option value="Vivienda familiar">Vivienda familiar</option>
            <option value="Unidad de inversión">Unidad de inversión</option>
          </select>
        </div>

        <textarea
          name="notes"
          placeholder="Notas (preferencia de luz, calle tranquila, tolerancia a reforma, necesidades familiares, ángulo de inversión, etc.)"
          class="min-h-[160px] w-full rounded-[24px] border border-black/10 bg-white px-4 py-3 text-[12px] leading-[1.8] text-black/70 placeholder:text-black/32"
        ></textarea>

        <div class="border-t border-black/10 pt-4">
          <div class="text-[12px] leading-[1.75] text-black/50">
            Las acciones demo de abajo generan un brief formateado — útil para probar el flujo antes de conectar un backend real.
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <button
              id="copy-brief-btn"
              type="button"
              class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/75 hover:border-black/20 hover:text-black"
            >
              Copiar brief
            </button>

            <button
              id="email-draft-btn"
              type="button"
              class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/75 hover:border-black/20 hover:text-black"
            >
              Borrador email
            </button>

            <button
              id="whatsapp-draft-btn"
              type="button"
              class="rounded-full border border-black/20 px-4 py-2 text-[12px] hover:border-black/30"
            >
              Borrador WhatsApp
            </button>
          </div>

          <div id="intake-status" class="mt-3 text-[12px] text-black/50"></div>
        </div>
      </form>
    </div>
  </section>

  <section class="mt-16 border-t border-black/10 pt-8">
    <div class="grid gap-0 md:grid-cols-3">
      {[
        ["01", "Recibir brief", "El intake se formatea como una solicitud más útil que un mensaje de contacto genérico."],
        ["02", "Revisar encaje", "Distrito, timing y presupuesto se evalúan antes de proponer cualquier shortlist."],
        ["03", "Responder con siguiente paso", "En producción: shortlist, ruta de visitas o llamada advisory según el brief."],
      ].map(([n, title, text]) => (
        <div class="border-b border-black/10 py-5 md:border-b-0 md:border-r md:px-5 md:last:border-r-0">
          <div class="text-[11px] tracking-[0.18em] text-black/38">{n}</div>
          <div class="mt-3 text-[17px] tracking-tight">{title}</div>
          <div class="mt-2 max-w-[280px] text-[12px] leading-[1.8] text-black/56">{text}</div>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("private-intake-form");
    const status = document.getElementById("intake-status");

    const copyBtn = document.getElementById("copy-brief-btn");
    const emailBtn = document.getElementById("email-draft-btn");
    const waBtn = document.getElementById("whatsapp-draft-btn");

    const phoneDigits = "34600000000";
    const emailTo = "advisory@example.com";

    const getValue = (name) => {
      const field = form?.elements?.namedItem(name);
      return field && "value" in field ? field.value.trim() : "";
    };

    const buildBrief = () => {
      const requestType = getValue("requestType") || "Compra";
      const name = getValue("name") || "—";
      const email = getValue("email") || "—";
      const districts = getValue("districts") || "Abierto";
      const budget = getValue("budget") || "Presupuesto abierto";
      const timing = getValue("timing") || "Timing flexible";
      const propertyType = getValue("propertyType") || "Cualquier tipo de propiedad";
      const notes = getValue("notes") || "—";

      return [
        "Barcelona Private Advisory — Brief de cliente",
        "",
        `Tipo de solicitud: ${requestType}`,
        `Nombre: ${name}`,
        `Email: ${email}`,
        `Distritos preferidos: ${districts}`,
        `Presupuesto: ${budget}`,
        `Timing: ${timing}`,
        `Tipo de propiedad: ${propertyType}`,
        `Notas: ${notes}`,
      ].join("\n");
    };

    const setStatus = (message) => {
      if (status) status.textContent = message;
      window.setTimeout(() => {
        if (status && status.textContent === message) status.textContent = "";
      }, 2200);
    };

    copyBtn?.addEventListener("click", async () => {
      const brief = buildBrief();

      try {
        await navigator.clipboard.writeText(brief);
        setStatus("Brief copiado.");
      } catch {
        window.prompt("Copiar brief:", brief);
      }
    });

    emailBtn?.addEventListener("click", () => {
      const brief = buildBrief();
      const subject = encodeURIComponent("Barcelona Private Advisory — Brief de cliente");
      const body = encodeURIComponent(brief);
      window.location.href = `mailto:${emailTo}?subject=${subject}&body=${body}`;
      setStatus("Abriendo borrador de email…");
    });

    waBtn?.addEventListener("click", () => {
      const brief = buildBrief();
      const text = encodeURIComponent(brief);
      window.open(`https://wa.me/${phoneDigits}?text=${text}`, "_blank", "noopener,noreferrer");
      setStatus("Abriendo borrador de WhatsApp…");
    });
  </script>
</BaseLayout>
