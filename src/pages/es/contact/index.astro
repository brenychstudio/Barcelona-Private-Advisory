---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "../../../components/islands/ContactForm";
---

<BaseLayout title="Contacto — Barcelona Private Advisory">
  <section class="space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">CONTACTO</div>
    <h1 class="text-[26px] tracking-tight">Iniciar conversación.</h1>
    <p class="max-w-[820px] text-[12px] text-black/60">
      Intake premium. En producción, el formulario conecta con CRM / email.
    </p>
  </section>

  <section class="mt-10 rounded-2xl border border-black/10 bg-white p-5">
    <ContactForm client:load lang="es" />
  </section>
</BaseLayout>
