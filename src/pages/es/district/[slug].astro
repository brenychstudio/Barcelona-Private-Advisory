---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { districts } from "../../../data/districts";
import { listings } from "../../../data/listings";

export function getStaticPaths() {
  return districts.map((d) => ({
    params: { slug: d.slug },
    props: { district: d },
  }));
}

const { district } = Astro.props;

const featured = listings
  .filter((x) => x.district.toLowerCase().includes(district.title.toLowerCase()))
  .slice(0, 3);

const factsMap: Record<string, string[]> = {
  eixample: ["Cuadrícula + caminabilidad", "Potencial de reforma", "Liquidez alta", "Conexiones"],
  gracia: ["Escala humana", "Diseño", "Bolsillos tranquilos", "Parques + cafés"],
  sarria: ["Perfil familiar", "Verde + calma", "Colegios", "Ruido bajo"],
  poblenou: ["Moderno + creativo", "Cerca de hubs tech", "Buena liquidez", "Stock loft"],
};
const facts =
  factsMap[district.slug] ?? ["Barcelona-first", "Encaje de estilo de vida", "Asesoría", "Trade-offs claros"];
---

<BaseLayout title={`${district.title} — Barcelona Lens`}>
  <section class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
      <div class="aspect-[16/9] bg-black/5">
        <img src={district.image} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
    </div>

    <div class="text-[12px] tracking-[0.18em] text-black/50">BARCELONA LENS</div>
    <h1 class="text-[26px] tracking-tight">{district.title}</h1>
    <p class="max-w-[760px] text-[12px] text-black/60">
      Recomendaciones por barrio: encaje de vida diaria, ruido, caminabilidad y demanda.
    </p>
  </section>

  <section class="mt-10">
    <div class="grid gap-3 md:grid-cols-2">
      {facts.slice(0, 4).map((t) => (
        <div class="rounded-2xl border border-black/10 bg-white p-4 text-[12px] text-black/70">
          {t}
        </div>
      ))}
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">DESTACADOS</div>
    <div class="grid gap-3 md:grid-cols-3">
      {featured.map((x) => (
        <a href={`/es/p/${x.id}`} class="overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="aspect-[4/5] bg-black/5">
            <img src={x.images.hero} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-4">
            <div class="text-[13px] font-medium">{x.title_es ?? x.title}</div>
            <div class="mt-1 text-[12px] text-black/60">
              {x.sqm} m² · €{Intl.NumberFormat("en-US").format(x.price)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
