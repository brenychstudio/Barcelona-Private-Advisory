---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listings } from "../../data/listings";
import { districts } from "../../data/districts";
import ShortlistToggle from "../../components/islands/ShortlistToggle";

const featured = listings.slice(0, 3);
---

<BaseLayout title="Barcelona Private Advisory">
  <section class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
      <div class="aspect-[16/9] bg-black/5">
        <img src="/demo/hero-home/hero-01.png" alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
    </div>

    <h1 class="max-w-[780px] text-[28px] leading-[1.1] tracking-tight">
      Asesoría privada inmobiliaria en Barcelona.
      <span class="text-black/55"> Selección curada en 72h.</span>
    </h1>

    <div class="flex gap-2">
      <a href="/es/search" class="rounded-full border border-black/15 px-4 py-2 text-[12px] hover:border-black/25">
        Iniciar búsqueda
      </a>
      <a
        href="/es/about"
        class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black"
      >
        Cómo trabajamos
      </a>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">SELECCIÓN CURADA</div>
    <div class="grid gap-3 md:grid-cols-3">
      {featured.map((x) => (
        <a href={`/es/p/${x.id}`} class="group overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="relative aspect-[4/5] bg-black/5">
            <ShortlistToggle client:idle id={x.id} className="absolute right-3 top-3" />
            <img src={x.images.hero} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>

          <div class="p-4">
            <div class="text-[13px] font-medium">{x.title_es ?? x.title}</div>
            <div class="mt-1 text-[12px] text-black/60">
              {x.district} · {x.sqm} m² · €{Intl.NumberFormat("en-US").format(x.price)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16 space-y-8">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="space-y-3">
        <div class="text-[12px] tracking-[0.18em] text-black/50">MÉTODO ADVISORY</div>
        <h2 class="max-w-[760px] text-[28px] leading-[1.05] tracking-tight">
          Una selección más estrecha. Una decisión más clara.
        </h2>
        <p class="max-w-[720px] text-[13px] leading-[1.7] text-black/60">
          Este producto no está construido alrededor del volumen. Está construido alrededor
          de la selección: encaje de distrito, lógica de compra, trade-offs reales y una
          shortlist que realmente puede explicarse al comprador.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {[
          ["Barcelona-first", "Encaje de barrio antes que volumen."],
          ["Selección en 72h", "Primera curaduría rápida y controlada."],
          ["Picks explicables", "Por qué encaja / por qué no."],
          ["Lente de due diligence", "Costes, restricciones y señales de liquidez."],
        ].map(([title, text]) => (
          <div class="rounded-2xl border border-black/10 bg-white p-4">
            <div class="text-[13px] font-medium">{title}</div>
            <div class="mt-2 text-[12px] leading-[1.6] text-black/60">{text}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-[28px] border border-black/10 bg-white p-4 sm:p-5">
      <div class="grid gap-3 md:grid-cols-4">
        {[
          ["01", "Definir", "Presupuesto, distritos, habitaciones, estilo de vida y criterios."],
          ["02", "Curar", "Rankear por encaje, no por volumen bruto."],
          ["03", "Reducir riesgo", "Detectar costes, restricciones y señales débiles."],
          ["04", "Cerrar", "Apoyar siguientes pasos, visitas y claridad de oferta."],
        ].map(([n, title, text]) => (
          <div class="rounded-2xl border border-black/10 bg-[rgb(var(--bg))] p-4">
            <div class="text-[12px] tracking-[0.14em] text-black/45">{n}</div>
            <div class="mt-2 text-[15px] font-medium tracking-tight">{title}</div>
            <div class="mt-2 text-[12px] leading-[1.6] text-black/60">{text}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="rounded-[28px] border border-black/10 bg-white p-5 sm:p-6">
        <div class="text-[12px] tracking-[0.18em] text-black/50">ADVISORY, NO CATÁLOGO</div>
        <div class="mt-3 max-w-[420px] text-[24px] leading-[1.08] tracking-tight">
          Una shortlist construida por encaje, no por ruido.
        </div>
      </div>

      <div class="rounded-[28px] border border-black/10 bg-white p-5 sm:p-6">
        <p class="max-w-[760px] text-[13px] leading-[1.75] text-black/60">
          El objetivo no es mostrarlo todo. El objetivo es reducir la fatiga de decisión,
          sacar a la superficie las opciones más fuertes y hacer visibles los trade-offs
          desde el principio — encaje de barrio, perfil de compra y claridad de siguiente paso
          en un flujo sereno.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">BARCELONA LENS</div>
    <div class="grid gap-3 md:grid-cols-4">
      {districts.slice(0, 4).map((d) => (
        <a href={`/es/district/${d.slug}`} class="overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="aspect-[4/3] bg-black/5">
            <img src={d.image} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-4">
            <div class="text-[13px] font-medium">{d.title}</div>
            <div class="mt-1 text-[12px] text-black/60">{d.fit}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
