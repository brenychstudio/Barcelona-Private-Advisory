---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { bcnMedia } from "../../data/bcnMedia";
import { bcnLensMedia } from "../../data/bcnLensMedia";
import { getRouteSeo } from "../../lib/seo";

const seo = getRouteSeo("about", "en");

const methodSteps = [
  ["01", "Brief", "Buyer constraints become the frame.", "Operating brief"],
  ["02", "Lens", "District logic narrows the field.", "Location fit"],
  ["03", "Signal", "Properties are ranked by fit.", "Reason to inspect"],
  ["04", "Dossier", "Selected options become a private file.", "Comparison logic"],
  ["05", "Action", "The viewing path is prepared.", "Copy-ready request"],
];

const modules = [
  ["Buyer Intent Surface", "Turns browsing into a buyer brief.", "Keeps inventory from taking over before the buyer priority is clear."],
  ["Barcelona Lens Field", "Makes district fit visible.", "Connects rhythm, access, light and value logic to the shortlist."],
  ["Product Object Surface", "Frames each listing as a recommendation.", "Shows why the property belongs before the user opens the detail."],
  ["Property Detail Chamber", "Expands the object into an acquisition file.", "Keeps memo, risk, readiness and next action in one decision surface."],
  ["Cinematic Inspect Gallery", "Turns images into inspection context.", "Keeps photo review inside the advisory flow instead of a generic modal."],
  ["Private Shortlist Dossier", "Builds a compact comparison file.", "Turns saved homes into priority, district spread and trade-off logic."],
  ["Advisory Inquiry Flow", "Creates a copy-ready request brief.", "Converts search, property and dossier context into an advisor handoff."],
];

const failures = [
  ["Too many options", "Interchangeable listings create volume without decision hierarchy."],
  ["Weak district context", "Location is reduced to a label instead of daily-life and value logic."],
  ["Hidden trade-offs", "Noise, renovation, liquidity or privacy issues appear too late."],
  ["No viewing priority", "The buyer cannot see which homes deserve inspection first."],
  ["Weak buyer-property connection", "Intent and shortlist logic stay disconnected from the objects shown."],
];

const values = [
  ["Primary effect", "Fewer but better options.", "The interface reduces inventory noise before buyer attention is spent."],
  ["Buyer confidence", "Stronger buyer confidence before viewings.", "Every recommendation carries a visible reason to inspect."],
  ["District fit", "Clearer district fit and acquisition logic.", "Location becomes a decision frame, not a passive filter."],
  ["Advisor output", "Advisor-ready shortlist instead of passive saved items.", "Saved homes become a private file with priority and trade-offs."],
  ["Premium perception", "Higher premium perception through calm, explainable selection.", "The product feels curated because the logic stays visible."],
];

const faqs = [
  ["Is this a catalog?", "No. It is a front-end advisory interface concept that can sit above real inventory and reduce browsing noise."],
  ["Can this support real inventory?", "Yes. In a deployment, the local data layer can be connected to a CMS, feed or CRM without changing the advisory model."],
  ["Why district-first?", "High-ticket property decisions are shaped by routine, light, noise, access and resale logic. District fit needs to be visible early."],
  ["What makes it premium?", "The product sells clarity: fewer choices, stronger reasoning, editorial media and a private decision path."],
  ["What happens after the shortlist?", "The dossier becomes a viewing path or advisory request brief, ready for a buyer advisor or boutique agency team."],
  ["Can it become a client-facing platform?", "Yes. This is a production-ready front-end direction that can be connected to live content, analytics and contact handoff."],
];
---

<BaseLayout seo={seo}>
  <section class="bcn-about-hero bcn-section grid gap-8 lg:grid-cols-[0.86fr_1.14fr] lg:items-end" data-bcn-reveal="section">
    <div class="space-y-5">
      <div class="bcn-signal-kicker text-[12px] uppercase tracking-[0.2em] text-black/42">Advisory method</div>
      <h1 class="bcn-advisory-line max-w-[760px] text-[42px] leading-[0.98] tracking-tight text-black/90 sm:text-[64px]">
        Private advisory, not catalog.
      </h1>
      <p class="max-w-[680px] text-[14px] leading-[1.85] text-black/58">
        A district-first acquisition interface that turns buyer intent into a shortlist, not endless browsing.
        It makes the logic behind selection visible before the first viewing is booked.
      </p>
    </div>

    <figure class="bcn-about-hero__media overflow-hidden border border-black/10 bg-[rgb(var(--paper))]" data-bcn-reveal="media" data-bcn-reveal-delay="1">
      <img
        src={bcnMedia.lens.districtLensDesk.src}
        alt="Private advisory desk with district lens material for Barcelona property selection"
        width={bcnMedia.lens.districtLensDesk.width}
        height={bcnMedia.lens.districtLensDesk.height}
        class="aspect-[16/10] w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </figure>

    <div class="bcn-about-system-readout lg:col-span-2" data-bcn-reveal="row" data-bcn-reveal-delay="2">
      <div class="grid gap-4 border border-black/10 bg-[rgb(var(--paper))] p-4 sm:grid-cols-[0.55fr_1fr] sm:items-center">
        <div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-black/36">Private Property Intelligence System</div>
          <p class="mt-2 max-w-[420px] text-[13px] leading-[1.65] text-black/58">
            One method spine connects intent, district fit, property signal, shortlist logic and advisory action.
          </p>
        </div>
        <div class="bcn-about-system-readout__spine grid gap-2 text-[12px] uppercase tracking-[0.16em] text-black/54 sm:grid-cols-5">
          <span>Brief</span>
          <span>Lens</span>
          <span>Signal</span>
          <span>Dossier</span>
          <span>Action</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bcn-section--threshold mt-28 grid gap-10 border-y border-black/10 py-14 lg:grid-cols-[0.72fr_1.28fr]" data-bcn-reveal="section">
    <div>
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Why catalog browsing fails</div>
      <h2 class="mt-4 max-w-[520px] text-[32px] leading-[1.02] tracking-tight">
        More options rarely create better decisions.
      </h2>
      <p class="mt-4 max-w-[440px] text-[13px] leading-[1.8] text-black/52">
        The problem is not inventory. The problem is weak decision structure before the buyer starts comparing.
      </p>
    </div>
    <div class="bcn-problem-field bcn-problem-field--diagnostic">
      {failures.map(([title, text], index) => (
        <article class={`bcn-problem-field__item ${index === 0 ? "bcn-problem-field__item--primary" : ""}`} data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <div class="bcn-problem-field__index">Issue {String(index + 1).padStart(2, "0")}</div>
          <div class="bcn-problem-field__copy">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bcn-method-field mt-24" data-bcn-reveal="section">
    <div class="grid gap-8 lg:grid-cols-[0.56fr_1fr] lg:items-end">
      <div class="space-y-4">
        <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">The advisory method</div>
        <h2 class="max-w-[620px] text-[34px] leading-[1.02] tracking-tight sm:text-[46px]">
          Buyer brief to viewing path.
        </h2>
      </div>
      <p class="max-w-[680px] text-[13px] leading-[1.85] text-black/56 lg:justify-self-end">
        The system does not ask the buyer to browse harder. It narrows the field, explains the signal and turns a shortlist into an advisor-ready output.
      </p>
    </div>

    <div class="bcn-method-spine mt-8 border border-black/10 bg-[rgb(var(--paper))]">
      {methodSteps.map(([n, title, role, output], index) => (
        <article class="bcn-method-spine__step grid gap-4 border-b border-black/10 p-4 last:border-b-0 md:grid-cols-[64px_0.55fr_0.9fr_0.55fr] md:items-center" data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <div class="text-[11px] tracking-[0.2em] text-black/34">{n}</div>
          <h3 class="text-[24px] leading-[1] tracking-tight text-black/88">{title}</h3>
          <p class="text-[13px] leading-[1.65] text-black/58">{role}</p>
          <div class="text-[10px] uppercase tracking-[0.16em] text-black/42">{output}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="bcn-operating-layers mt-24 grid gap-10 lg:grid-cols-[0.72fr_1.28fr]" data-bcn-reveal="section">
    <div class="space-y-4">
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Operating layers</div>
      <h2 class="max-w-[520px] text-[32px] leading-[1.03] tracking-tight">
        Client-facing outcomes, not internal technology.
      </h2>
      <p class="max-w-[500px] text-[13px] leading-[1.85] text-black/56">
        Each layer supports one business moment: clarify intent, make district logic visible,
        explain property fit, prepare the shortlist and convert interest into a viewing request.
      </p>
    </div>

    <div class="bcn-operating-layers__stack border-y border-black/10">
      {modules.map(([title, outcome, why], index) => (
        <article class="bcn-operating-layer grid gap-3 border-b border-black/10 py-5 last:border-b-0 md:grid-cols-[42px_0.75fr_1fr]" data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <div class="text-[10px] uppercase tracking-[0.18em] text-black/32">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <h3 class="text-[16px] leading-[1.25] tracking-tight text-black/84">{title}</h3>
            <p class="mt-2 text-[13px] leading-[1.55] text-black/70">{outcome}</p>
          </div>
          <p class="text-[12px] leading-[1.7] text-black/54">{why}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bcn-editorial-surface bcn-value-proof mt-28 overflow-hidden border border-black/10 bg-[rgb(var(--paper))]" data-bcn-reveal="section">
    <div class="grid gap-0 lg:grid-cols-[0.9fr_1.1fr]">
      <figure class="min-h-[320px]" data-bcn-reveal="media">
        <img
          src={bcnLensMedia.materials.handoff.src}
          alt={bcnLensMedia.materials.handoff.alt}
          width={bcnLensMedia.materials.handoff.width}
          height={bcnLensMedia.materials.handoff.height}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="p-6 sm:p-8 lg:p-10">
        <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Business value</div>
        <h2 class="mt-4 max-w-[560px] text-[34px] leading-[1.02] tracking-tight">
          The product sells decision clarity.
        </h2>
        <div class="bcn-value-proof__ledger mt-8">
          {values.map(([label, title, text], index) => (
            <article class={`bcn-value-proof__item ${index === 0 ? "bcn-value-proof__item--primary" : ""}`} data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
              <div class="bcn-value-proof__meta">
                <span>{label}</span>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-24 grid gap-10 lg:grid-cols-[0.74fr_1.26fr]" data-bcn-reveal="section">
    <div class="space-y-4">
      <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">FAQ</div>
      <h2 class="max-w-[520px] text-[32px] leading-[1.03] tracking-tight">
        Buyer and agency questions.
      </h2>
    </div>

    <div class="bcn-quiet-faq border-t border-black/10">
      {faqs.map(([q, a], index) => (
        <div class="grid gap-3 border-b border-black/10 py-5 sm:grid-cols-[240px_1fr]" data-bcn-reveal="row" data-bcn-reveal-delay={String(Math.min(index + 1, 3))}>
          <h3 class="text-[13px] font-medium leading-[1.45] text-black/78">{q}</h3>
          <p class="text-[12px] leading-[1.8] text-black/52">{a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bcn-about-final-cta mt-20 border-t border-black/10 pt-8" data-bcn-reveal="section">
    <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="space-y-3">
        <div class="text-[12px] uppercase tracking-[0.2em] text-black/42">Next step</div>
        <h2 class="max-w-[620px] text-[28px] leading-[1.08] tracking-tight">
          Start with a private brief.
        </h2>
      </div>

      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-open-inquiry
          data-inquiry-source="hero"
          data-inquiry-next-action="Start private search"
          class="rounded-full border border-black/20 bg-white px-4 py-2 text-[12px] hover:border-black/35 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
        >
          Start private search
        </button>
        <a
          href="/#advisory"
          class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black/50"
        >
          Open district lens
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
