---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { districts } from "../../data/districts";
import { listings } from "../../data/listings";

export function getStaticPaths() {
  return districts.map((d) => ({ params: { slug: d.slug }, props: { district: d } }));
}

const { district } = Astro.props;

const featured = listings
  .filter((x) => x.district.toLowerCase().includes(district.title.toLowerCase()))
  .slice(0, 3);

const factsMap: Record<string, string[]> = {
  eixample: ["Grid + walkability", "Renovation potential", "Classic balconies", "Strong rental demand"],
  gracia: ["Human scale streets", "Design-forward vibe", "Quiet pockets", "Local cafés + parks"],
  sarria: ["Family fit", "Green + calm", "Schools nearby", "Low noise"],
  poblenou: ["Modern + creative", "Near tech hubs", "Industrial-to-premium stock", "Good liquidity"],
  "diagonal-mar": ["Coastal modern", "Views + terraces", "Newer buildings", "Concierge amenities"],
  barceloneta: ["Sea proximity", "Walkable lifestyle", "Compact units", "Short-term demand (where legal)"],
  pedralbes: ["Privacy + villas", "Quiet luxury", "Green streets", "High-end long-term demand"],
};

const facts = factsMap[district.slug] ?? ["Barcelona-first fit", "Quiet premium", "Lifestyle matching", "Advisory lens"];
---

<BaseLayout title={`${district.title} — Barcelona Lens`}>
  <section class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
      <div class="aspect-[16/9] bg-black/5">
        <img src={district.image} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
    </div>

    <div class="text-[12px] tracking-[0.18em] text-black/50">BARCELONA LENS</div>
    <h1 class="text-[26px] tracking-tight">{district.title}</h1>
    <p class="max-w-[760px] text-[12px] text-black/60">{district.fit}</p>
  </section>

  <section class="mt-10">
    <div class="grid gap-3 md:grid-cols-2">
      {facts.map((t) => (
        <div class="rounded-2xl border border-black/10 bg-white p-4 text-[12px] text-black/70">
          {t}
        </div>
      ))}
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">FEATURED</div>
    <div class="grid gap-3 md:grid-cols-3">
      {featured.map((x) => (
        <a href={`/p/${x.id}`} class="overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="aspect-[4/5] bg-black/5">
            <img src={x.images.hero} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-4">
            <div class="text-[13px] font-medium">{x.title}</div>
            <div class="mt-1 text-[12px] text-black/60">
              {x.sqm} m² · €{Intl.NumberFormat("en-US").format(x.price)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
