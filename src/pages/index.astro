---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listings } from "../data/listings";
import { districts } from "../data/districts";
import ShortlistToggle from "../components/islands/ShortlistToggle";

const featured = listings.slice(0, 3);
---

<BaseLayout title="Barcelona Private Advisory">
  <section class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
      <div class="aspect-[16/9] bg-black/5">
        <img
          src="/demo/hero-home/hero-01.png"
          alt=""
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <h1 class="max-w-[780px] text-[28px] leading-[1.1] tracking-tight">
      Barcelona Private Property Advisory.
      <span class="text-black/55"> Curated shortlist in 72h.</span>
    </h1>

    <div class="flex gap-2">
      <a href="/search" class="rounded-full border border-black/15 px-4 py-2 text-[12px] hover:border-black/25">
        Start a search
      </a>
      <a href="/about" class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black">
        How we work
      </a>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">CURATED DROPS</div>
    <div class="grid gap-3 md:grid-cols-3">
      {featured.map((x) => (
        <a href={`/p/${x.id}`} class="group overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="relative aspect-[4/5] bg-black/5">
  <ShortlistToggle client:idle id={x.id} className="absolute right-3 top-3" />
  <img src={x.images.hero} alt="" class="h-full w-full object-cover" loading="lazy" />
</div>

          <div class="p-4">
            <div class="text-[13px] font-medium">{x.title}</div>
            <div class="mt-1 text-[12px] text-black/60">
              {x.district} · {x.sqm} m² · €{Intl.NumberFormat("en-US").format(x.price)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ADVISORY PROMISE -->
  <section class="mt-14 space-y-4">
    <div class="text-[12px] tracking-[0.18em] text-black/50">ADVISORY PROMISE</div>

    <div class="grid gap-3 md:grid-cols-2">
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Shortlist</div>
        <div class="mt-1 text-[18px] tracking-tight">Curated shortlist in 72h.</div>
        <div class="mt-2 text-[12px] text-black/60">
          Best fit over bulk. We optimize for lifestyle, neighborhood fit, and risk profile.
        </div>
      </div>

      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Due diligence</div>
        <div class="mt-1 text-[18px] tracking-tight">Risk flags, fees, and constraints.</div>
        <div class="mt-2 text-[12px] text-black/60">
          Clear notes: acquisition costs, HOA signals, renovation constraints, liquidity lens (demo).
        </div>
      </div>

      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Negotiation</div>
        <div class="mt-1 text-[18px] tracking-tight">Offer strategy and closing support.</div>
        <div class="mt-2 text-[12px] text-black/60">
          We help align price, terms, and timelines with your constraints.
        </div>
      </div>

      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Barcelona Lens</div>
        <div class="mt-1 text-[18px] tracking-tight">Neighborhood-first recommendations.</div>
        <div class="mt-2 text-[12px] text-black/60">
          Not “all Spain”. Barcelona districts, lifestyle match, and practical trade-offs.
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF / TRUST -->
  <section class="mt-14 space-y-4">
    <div class="text-[12px] tracking-[0.18em] text-black/50">PROOF & TRUST</div>

    <div class="grid gap-3 md:grid-cols-4">
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Method</div>
        <div class="mt-1 text-[18px] tracking-tight">Advisory, not catalog.</div>
        <div class="mt-2 text-[12px] text-black/60">Curated drops + ranking lens.</div>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Clarity</div>
        <div class="mt-1 text-[18px] tracking-tight">Explainable picks.</div>
        <div class="mt-2 text-[12px] text-black/60">Why this fits / why not.</div>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Speed</div>
        <div class="mt-1 text-[18px] tracking-tight">72h shortlist.</div>
        <div class="mt-2 text-[12px] text-black/60">Fast iterations, quiet UX.</div>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <div class="text-[12px] text-black/50">Share</div>
        <div class="mt-1 text-[18px] tracking-tight">Shareable shortlist.</div>
        <div class="mt-2 text-[12px] text-black/60">One link → same selection.</div>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-black/10 bg-white p-5">
      <div class="text-[12px] tracking-[0.18em] text-black/50">HOW WE WORK</div>
      <div class="mt-4 grid gap-3 md:grid-cols-4">
        {[
          ["01", "Define constraints", "Budget, districts, beds, lifestyle."],
          ["02", "Curate shortlist", "Rank by fit + lens, not by volume."],
          ["03", "Due diligence", "Fees, flags, and negotiation prep."],
          ["04", "Viewings & close", "Schedule, offer strategy, support."],
        ].map(([n, t, d]) => (
          <div class="rounded-2xl border border-black/10 bg-white p-4">
            <div class="text-[12px] text-black/50">{n}</div>
            <div class="mt-1 text-[13px] font-medium">{t}</div>
            <div class="mt-1 text-[12px] text-black/60">{d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">BARCELONA LENS</div>
    <div class="grid gap-3 md:grid-cols-4">
      {districts.slice(0, 4).map((d) => (
        <a href={`/district/${d.slug}`} class="overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="aspect-[4/3] bg-black/5">
            <img src={d.image} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-4">
            <div class="text-[13px] font-medium">{d.title}</div>
            <div class="mt-1 text-[12px] text-black/60">{d.fit}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
