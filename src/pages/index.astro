---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listings } from "../data/listings";
import { districts } from "../data/districts";
import ShortlistToggle from "../components/islands/ShortlistToggle";

const featured = listings.slice(0, 3);
---

<BaseLayout title="Barcelona Private Advisory">
  <section class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
      <div class="aspect-[16/9] bg-black/5">
        <img
          src="/demo/hero-home/hero-01.png"
          alt=""
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <h1 class="max-w-[780px] text-[28px] leading-[1.1] tracking-tight">
      Barcelona Private Property Advisory.
      <span class="text-black/55"> Curated shortlist in 72h.</span>
    </h1>

    <div class="flex gap-2">
      <a href="/search" class="rounded-full border border-black/15 px-4 py-2 text-[12px] hover:border-black/25">
        Start a search
      </a>
      <a href="/about" class="rounded-full border border-black/10 px-4 py-2 text-[12px] text-black/70 hover:border-black/20 hover:text-black">
        How we work
      </a>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">CURATED DROPS</div>
    <div class="grid gap-3 md:grid-cols-3">
      {featured.map((x) => (
        <a href={`/p/${x.id}`} class="group overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="relative aspect-[4/5] bg-black/5">
  <ShortlistToggle client:idle id={x.id} className="absolute right-3 top-3" />
  <img src={x.images.hero} alt="" class="h-full w-full object-cover" loading="lazy" />
</div>

          <div class="p-4">
            <div class="text-[13px] font-medium">{x.title}</div>
            <div class="mt-1 text-[12px] text-black/60">
              {x.district} · {x.sqm} m² · €{Intl.NumberFormat("en-US").format(x.price)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-20 space-y-10">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="space-y-4">
        <div class="text-[12px] tracking-[0.18em] text-black/45">ADVISORY METHOD</div>

        <h2 class="max-w-[720px] text-[30px] leading-[1.02] tracking-tight sm:text-[36px]">
          A narrower shortlist.
          <br />
          A more intelligent decision.
        </h2>

        <p class="max-w-[660px] text-[13px] leading-[1.8] text-black/58">
          This product is not designed to increase volume. It is designed to reduce noise ?
          using district fit, acquisition logic, explainable ranking, and practical trade-offs
          to shape a shortlist a buyer can actually act on.
        </p>
      </div>

      <div class="border-y border-black/10">
        {[
          ["Barcelona-first", "District fit before generic catalog volume."],
          ["72h shortlist", "Fast first pass with controlled selection."],
          ["Explainable picks", "Clear logic: why this fits, why it doesn?t."],
          ["Due diligence lens", "Fees, restrictions, liquidity, weak signals."],
        ].map(([title, text]) => (
          <div class="grid gap-2 border-b border-black/10 py-4 last:border-b-0 sm:grid-cols-[170px_1fr]">
            <div class="text-[13px] font-medium">{title}</div>
            <div class="text-[12px] leading-[1.7] text-black/58">{text}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="overflow-hidden rounded-[28px] border border-black/10 bg-white">
      <div class="grid gap-0 md:grid-cols-4">
        {[
          ["01", "Define", "Budget, districts, beds, lifestyle, constraints."],
          ["02", "Curate", "Rank by fit, not by raw listing count."],
          ["03", "De-risk", "Flag costs, restrictions, and weak signals."],
          ["04", "Close", "Support next steps, viewings, and offer clarity."],
        ].map(([n, title, text]) => (
          <div class="border-b border-black/10 p-5 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
            <div class="text-[11px] tracking-[0.18em] text-black/40">{n}</div>
            <div class="mt-3 text-[17px] tracking-tight">{title}</div>
            <div class="mt-2 text-[12px] leading-[1.7] text-black/58">{text}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-6 border-t border-black/10 pt-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="space-y-3">
        <div class="text-[12px] tracking-[0.18em] text-black/45">ADVISORY, NOT CATALOG</div>
        <div class="max-w-[420px] text-[28px] leading-[1.06] tracking-tight">
          A shortlist shaped by fit, not by noise.
        </div>
      </div>

      <div class="max-w-[760px] text-[13px] leading-[1.85] text-black/58">
        The goal is not to show everything. The goal is to reduce decision fatigue, surface the
        strongest options sooner, and make trade-offs visible early ? neighborhood fit, acquisition
        profile, and next-step clarity inside one quiet, premium flow.
      </div>
    </div>
  </section>

  <section class="mt-14 space-y-3">
    <div class="text-[12px] tracking-[0.18em] text-black/50">BARCELONA LENS</div>
    <div class="grid gap-3 md:grid-cols-4">
      {districts.slice(0, 4).map((d) => (
        <a href={`/district/${d.slug}`} class="overflow-hidden rounded-2xl border border-black/10 bg-white hover:border-black/20">
          <div class="aspect-[4/3] bg-black/5">
            <img src={d.image} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="p-4">
            <div class="text-[13px] font-medium">{d.title}</div>
            <div class="mt-1 text-[12px] text-black/60">{d.fit}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
