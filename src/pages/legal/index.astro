---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalPlaceholderPage from "../../components/legal/LegalPlaceholderPage.astro";
import { legalPlaceholderCopy } from "../../components/legal/legalPlaceholderContent";

const page = legalPlaceholderCopy.en.legal;
---

<BaseLayout title={page.pageTitle} description={page.description}>
  <LegalPlaceholderPage
    lang="en"
    title={page.title}
    eyebrow={page.eyebrow}
    intro={page.intro}
    sections={page.sections}
    lastUpdatedLabel="Prototype status"
    backHref="/"
    backLabel="Back to home"
  />
</BaseLayout>
