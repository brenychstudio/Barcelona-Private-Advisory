---
const PHONE = "34600000000"; // TODO: replace with real WhatsApp number (no +)
const TEXT =
  "Hi! I'd like to start a Barcelona property search. Please curate a shortlist in 72h.";
const href = `https://wa.me/${PHONE}?text=${encodeURIComponent(TEXT)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="fixed bottom-5 right-5 z-[70] flex items-center gap-2 rounded-full border border-black/10 bg-white/95 px-4 py-3 text-[12px] text-black/75 shadow-[0_12px_50px_rgba(0,0,0,0.08)] backdrop-blur hover:border-black/20 hover:text-black"
>
  <span class="grid h-6 w-6 place-items-center rounded-full border border-black/10 bg-white">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.55 15.2L2 22l4.93-1.37A10 10 0 1 0 12 2Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path
        d="M8.9 8.8c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.5 0 1.5 1.1 3 1.3 3.2.2.2 2.1 3.4 5.2 4.6 2.6 1 3.1.8 3.7.7.6-.1 2-.8 2.3-1.6.3-.8.3-1.4.2-1.6-.1-.2-.3-.3-.6-.4l-2-.9c-.3-.1-.6-.2-.9.2-.3.4-.8 1-.9 1.2-.2.2-.4.2-.7.1-.3-.1-1.3-.5-2.5-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.4.1-.6l.6-.7c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-.7-1.8Z"
        fill="currentColor"
        opacity="0.9"
      />
    </svg>
  </span>

  <span class="hidden sm:inline">WhatsApp</span>
  <span class="sm:hidden">WA</span>
</a>
