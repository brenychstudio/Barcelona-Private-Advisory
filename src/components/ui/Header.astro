---
import ShortlistWidget from "../islands/ShortlistWidget";
import SearchIntake from "../islands/SearchIntake";
import { listings } from "../../data/listings";

const path = Astro.url.pathname;
const isEs = path.startsWith("/es");
const lang = isEs ? "es" : "en";

const base = isEs ? (path.replace(/^\/es/, "") || "/") : path;
const enHref = base;
const esHref = base === "/" ? "/es" : `/es${base}`;

const nav =
  lang === "es"
    ? [
        { href: "/es", label: "Inicio" },
        { href: "/es/search", label: "Buscar" },
        { href: "/es/about", label: "Sobre" },
        { href: "/es/contact", label: "Contacto" },
      ]
    : [
        { href: "/", label: "Home" },
        { href: "/search", label: "Search" },
        { href: "/about", label: "About" },
        { href: "/contact", label: "Contact" },
      ];

const searchHref = lang === "es" ? "/es/search" : "/search";

const districts = Array.from(new Set(listings.map((x) => x.district).filter(Boolean))).sort((a, b) =>
  a.localeCompare(b)
);
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-[rgb(var(--bg))]/80 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-[1200px] items-center justify-between px-4">
    <a
      href={lang === "es" ? "/es" : "/"}
      class="max-w-[128px] text-[12px] font-medium leading-[1.15] tracking-tight sm:max-w-none sm:text-[13px]"
    >
      Barcelona Private Advisory
    </a>

    <!-- IMPORTANT: widget must stay mounted on all screens -->
    <ShortlistWidget client:load listings={listings} lang={lang} className="hidden md:inline-flex" />

    <!-- Desktop -->
    <nav class="hidden items-center gap-3 text-[12px] text-black/70 md:flex">
      {nav.map((x) => (
        <a href={x.href} class="hover:text-black">{x.label}</a>
      ))}

      <div class="mx-1 h-4 w-px bg-black/10"></div>

      <a
        href={enHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "en" ? "border-black/25 text-black" : "border-black/10 text-black/60 hover:border-black/20 hover:text-black")}
      >
        EN
      </a>
      <a
        href={esHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "es" ? "border-black/25 text-black" : "border-black/10 text-black/60 hover:border-black/20 hover:text-black")}
      >
        ES
      </a>

      <SearchIntake client:load districts={districts} lang={lang} />
    </nav>

    <!-- Mobile -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={enHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "en" ? "border-black/25 text-black" : "border-black/10 text-black/60")}
      >
        EN
      </a>
      <a
        href={esHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "es" ? "border-black/25 text-black" : "border-black/10 text-black/60")}
      >
        ES
      </a>

      <details id="mobile-nav" class="relative">
        <summary class="list-none rounded-full border border-black/15 px-3 py-1.5 text-[12px] text-black/75">
          {lang === "es" ? "Menú" : "Menu"}
        </summary>

        <div class="absolute right-0 top-[calc(100%+12px)] z-[90] w-[min(92vw,360px)] overflow-hidden rounded-2xl border border-black/10 bg-white shadow-[0_24px_80px_rgba(0,0,0,0.08)]">
          <div class="border-b border-black/10 px-4 py-3 text-[11px] tracking-[0.18em] text-black/45">
            {lang === "es" ? "NAVEGACIÓN" : "NAVIGATION"}
          </div>

          <div class="grid gap-1 p-2">
            {nav.map((x) => (
              <a
                href={x.href}
                class="rounded-xl px-3 py-2 text-[13px] text-black/75 hover:bg-black/[0.03] hover:text-black"
              >
                {x.label}
              </a>
            ))}
          </div>

          <div class="mx-2 h-px bg-black/10"></div>

          <div class="p-3">
            <div class="grid gap-2">
              <button
                id="mobile-open-shortlist"
                type="button"
                class="rounded-full border border-black/10 px-4 py-2 text-center text-[12px] text-black/75 hover:border-black/20 hover:text-black"
              >
                {lang === "es" ? "Abrir selección" : "Open shortlist"}
              </button>

              <a
                href={searchHref}
                class="rounded-full border border-black/25 bg-white px-4 py-2 text-center text-[12px] text-black hover:border-black/35"
              >
                {lang === "es" ? "Iniciar búsqueda" : "Start a search"}
              </a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>

  <script is:inline>
    const bindMobileShortlist = () => {
      const btn = document.getElementById("mobile-open-shortlist");
      const nav = document.getElementById("mobile-nav");

      if (!btn) return;

      btn.onclick = () => {
        if (nav) nav.removeAttribute("open");
        window.setTimeout(() => {
          window.dispatchEvent(new CustomEvent("sc:shortlist_ui_open"));
        }, 60);
      };
    };

    bindMobileShortlist();
    document.addEventListener("astro:after-swap", bindMobileShortlist);
  </script>
</header>
