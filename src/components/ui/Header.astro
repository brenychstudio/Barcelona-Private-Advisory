---
import ShortlistWidget from "../islands/ShortlistWidget";
import SearchIntake from "../islands/SearchIntake";
import { listings } from "../../data/listings";

const path = Astro.url.pathname;
const isEs = path.startsWith("/es");
const lang = isEs ? "es" : "en";

const base = isEs ? (path.replace(/^\/es/, "") || "/") : path;
const enHref = base;
const esHref = base === "/" ? "/es" : `/es${base}`;

const nav =
  lang === "es"
    ? [
        { href: "/es", label: "Inicio" },
        { href: "/es/search", label: "Buscar" },
        { href: "/es/about", label: "Sobre" },
        { href: "/es/contact", label: "Contacto" },
      ]
    : [
        { href: "/", label: "Home" },
        { href: "/search", label: "Search" },
        { href: "/about", label: "About" },
        { href: "/contact", label: "Contact" },
      ];

const districts = Array.from(new Set(listings.map((x) => x.district).filter(Boolean))).sort((a, b) =>
  a.localeCompare(b)
);
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-[rgb(var(--bg))]/80 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-[1200px] items-center justify-between px-4">
    <a href={lang === "es" ? "/es" : "/"} class="text-[13px] font-medium tracking-tight">
      Barcelona Private Advisory
    </a>

    <nav class="flex items-center gap-3 text-[12px] text-black/70">
      {nav.map((x) => (
        <a href={x.href} class="hover:text-black">{x.label}</a>
      ))}

      <div class="mx-1 h-4 w-px bg-black/10"></div>

      <a
        href={enHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "en" ? "border-black/25 text-black" : "border-black/10 text-black/60 hover:border-black/20 hover:text-black")}
      >
        EN
      </a>
      <a
        href={esHref}
        class={"rounded-full border px-3 py-1.5 text-[12px] " + (lang === "es" ? "border-black/25 text-black" : "border-black/10 text-black/60 hover:border-black/20 hover:text-black")}
      >
        ES
      </a>

      <ShortlistWidget client:load listings={listings} lang={lang} />
      <SearchIntake client:load districts={districts} lang={lang} />
    </nav>
  </div>
</header>
